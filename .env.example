# ==============================================================================
# APNASTAY CMS — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Environment Tier (production | staging | development | local)
WP_ENVIRONMENT_TYPE=local

# WordPress Site & Home URLs (automatically detects host in wp-config.php)
WP_HOME=http://localhost:8888
WP_SITEURL=http://localhost:8888

# Headless Next.js Frontend URL (for login redirects, CORS, and ISR webhooks)
APNASTAY_FRONTEND_URL=http://localhost:3000

# Shared Session Cookie Domain (use .apnastay.in in production)
COOKIE_DOMAIN=

# Database Settings
DB_NAME=apnastay_db
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1:8889
